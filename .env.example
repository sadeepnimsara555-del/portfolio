# ============================================================
#  EmailJS Configuration — copy this file to .env and fill in your real values
#  DO NOT commit the actual .env file (it's in .gitignore)
# ============================================================

# 1. Go to https://www.emailjs.com/ and sign in
# 2. Services tab → Create Service → copy the Service ID
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# 3. Email Templates tab → Create Template → copy the Template ID
#    Template must use variables: {{from_name}}, {{from_email}}, {{subject}}, {{message}}
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here

# 4. Account → API Keys → copy your Public Key
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
